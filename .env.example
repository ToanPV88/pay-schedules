# Sao chép thành .env (bị .gitignore) rồi điền giá trị. Không commit .env.
# Tệp này chỉ chứa TÊN biến, không chứa bí mật.

# ID tài khoản Cloudflare (không phải bí mật). Trong CI là biến vars.CLOUDFLARE_ACCOUNT_ID.
CLOUDFLARE_ACCOUNT_ID=
# Token Cloudflare: chỉ đặt trong GitHub Actions secrets hoặc biến môi trường cục bộ khi cần.
CLOUDFLARE_API_TOKEN=

# User-Agent của pipeline khi tải tài liệu (Công đoạn 5): tên dự án + cách liên hệ.
PAY_USER_AGENT=
