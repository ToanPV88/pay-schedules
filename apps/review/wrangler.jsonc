// Trang xem tay nội bộ của pipeline PDF (PLAN Công đoạn 5, DECISIONS.md D-021).
// Worker riêng, không dùng chung code với apps/web. Không lập chỉ mục.
// Mật khẩu đặt bằng `wrangler secret put REVIEW_PASSWORD` (workflow deploy-review.yml lấy từ
// GitHub secret cùng tên). Chưa có mật khẩu thì mọi yêu cầu bị từ chối.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "pay-schedules-review",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "vars": { "ENVIRONMENT": "production" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pay-schedules",
      "database_id": "365b3cca-bc4e-47e2-93cc-2f1d4b00fd87",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  "env": {
    "preview": {
      "name": "pay-schedules-review-preview",
      "workers_dev": true,
      "preview_urls": false,
      "vars": { "ENVIRONMENT": "preview" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "pay-schedules-preview",
          "database_id": "6ff58258-f26c-48ee-b64a-e04e6158bb61",
          "migrations_dir": "../../packages/db/migrations"
        }
      ]
    }
  }
}
