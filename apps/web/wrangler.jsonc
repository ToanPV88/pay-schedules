// Cấu hình Worker web. ID tài nguyên Cloudflare không phải bí mật.
// Khóa bí mật đặt bằng `wrangler secret put`, không ghi vào tệp này (AGENTS.md §4).
// ID của CSDL lấy từ lần chạy bootstrap-cloudflare.yml ngày 2026-11-12.
// Không dùng R2: tài liệu gốc lưu trong GitHub Release (DECISIONS.md D-011).
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "pay-schedules",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "observability": { "enabled": true },
  "assets": { "directory": "./public", "binding": "ASSETS" },
  // Workers Cache: cache trang theo Cache-Control, xóa theo Cache-Tag (DECISIONS.md D-102).
  "cache": { "enabled": true },
  // Giới hạn tần suất theo IP, chỉ tính lần trượt cache (src/guard.ts, D-108). namespace_id là số
  // riêng trong tài khoản Cloudflare (dùng chung với travienphi, hospital-price-ai): chọn dải 73xx
  // để không trùng bộ đếm của Worker khác. period chỉ được 10 hoặc 60.
  // Việc định kỳ (UTC): xóa báo lỗi quá 180 ngày (src/index.ts `scheduled`, D-109).
  "triggers": { "crons": ["41 9 * * *"] },
  "ratelimits": [
    { "name": "PAGE_LIMITER", "namespace_id": "7301", "simple": { "limit": 120, "period": 60 } },
    { "name": "API_LIMITER", "namespace_id": "7302", "simple": { "limit": 60, "period": 60 } },
    { "name": "DOWNLOAD_LIMITER", "namespace_id": "7303", "simple": { "limit": 15, "period": 60 } }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    // D-002: chưa có tên miền thì không cho lập chỉ mục.
    "INDEXABLE": "false",
    // Chừa chỗ quảng cáo: bật ở Công đoạn 8 khi có mã quảng cáo.
    "AD_SLOTS": "false",
    // Form báo lỗi tắt cho tới khi có khóa Turnstile (D-104). Khóa bí mật đặt bằng wrangler secret.
    "TURNSTILE_SITE_KEY": "",
    "CONTACT_EMAIL": ""
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pay-schedules",
      "database_id": "365b3cca-bc4e-47e2-93cc-2f1d4b00fd87",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  "env": {
    // Worker riêng cho bản xem trước. Mỗi pull request là một preview alias của Worker này
    // (`wrangler versions upload --env preview --preview-alias pr-<số>`), dùng CSDL preview.
    "preview": {
      "name": "pay-schedules-preview",
      "workers_dev": true,
      "preview_urls": true,
      // Bản xem trước không chạy việc định kỳ.
      "triggers": { "crons": [] },
      // Bộ đếm riêng cho bản xem trước.
      "ratelimits": [
        {
          "name": "PAGE_LIMITER",
          "namespace_id": "7311",
          "simple": { "limit": 120, "period": 60 }
        },
        { "name": "API_LIMITER", "namespace_id": "7312", "simple": { "limit": 60, "period": 60 } },
        {
          "name": "DOWNLOAD_LIMITER",
          "namespace_id": "7313",
          "simple": { "limit": 15, "period": 60 }
        }
      ],
      "vars": {
        "ENVIRONMENT": "preview",
        "INDEXABLE": "false",
        // Bản xem trước hiện khung quảng cáo rỗng để kiểm bố cục và Lighthouse.
        "AD_SLOTS": "true",
        "TURNSTILE_SITE_KEY": "",
        "CONTACT_EMAIL": ""
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "pay-schedules-preview",
          "database_id": "6ff58258-f26c-48ee-b64a-e04e6158bb61",
          "migrations_dir": "../../packages/db/migrations"
        }
      ]
    }
  }
}
